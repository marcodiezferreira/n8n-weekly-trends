    {
      "id": "fb37d6a9-94fa-5fca-8eed-1d33a6b0a5fb",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        200
      ],
      "parameters": {
        "jsCode": "// Todas las fuentes al mismo formato: { fuente, titulo, enlace, senal, puntos, resumen }. Solo los últimos 8 días.\nconst limite = Date.now() - 8 * 86400000;\nconst host = u => (String(u || '').match(/^https?:\\/\\/([^\\/?#]+)/i) || [])[1] || '';\nconst salida = [];\nconst push = o => { if (o.titulo && o.enlace) salida.push({ json: o }); };\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  if (Array.isArray(j.hits)) {\n    for (const h of j.hits) push({ fuente: 'Hacker News', titulo: h.title, enlace: h.url || `https://news.ycombinator.com/item?id=${h.objectID}`,\n      senal: `${h.points} puntos en Hacker News`, puntos: Number(h.points) || 0, resumen: '' });\n  } else if (Array.isArray(j.items) && j.total_count !== undefined) {\n    for (const r of j.items) push({ fuente: 'GitHub', titulo: `${r.full_name}: ${r.description || ''}`.slice(0, 200), enlace: r.html_url,\n      senal: `${r.stargazers_count} estrellas en GitHub`, puntos: Math.round((Number(r.stargazers_count) || 0) / 10), resumen: r.language || '' });\n  } else if (j.id && j.likes !== undefined && j.downloads !== undefined) {\n    push({ fuente: 'Hugging Face', titulo: `Modelo ${j.id} (${j.pipeline_tag || 'IA'})`, enlace: `https://huggingface.co/${j.id}`,\n      senal: `${j.likes} me gusta en Hugging Face`, puntos: Number(j.trendingScore) || 0, resumen: '' });\n  } else if (j.link && j.title) {\n    const fecha = new Date(j.isoDate || j.pubDate || 0);\n    if (isNaN(fecha) || fecha.getTime() < limite) continue;\n    push({ fuente: host(j.link).replace(/^www\\./, ''), titulo: String(j.title).trim(), enlace: j.link, senal: '', puntos: 30,\n      resumen: String(j.contentSnippet || '').replace(/\\s+/g, ' ').slice(0, 250) });\n  }\n}\nreturn salida;"
      }
    },
    {
      "id": "1c8cdee3-960a-53ff-a065-6b595b3ecdeb",
      "name": "Preparar lista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "jsCode": "// Las mejores de cada fuente en un solo texto numerado (una única llamada al modelo).\nconst porFuente = {};\nfor (const x of $input.all().map(i => i.json)) (porFuente[x.fuente] = porFuente[x.fuente] || []).push(x);\nconst lista = [];\nfor (const f of Object.keys(porFuente)) lista.push(...porFuente[f].sort((a, b) => b.puntos - a.puntos).slice(0, 12));\nif (!lista.length) return [];\nconst texto = lista.map((n, i) => `${i}. [${n.fuente}${n.senal ? ' · ' + n.senal : ''}] ${n.titulo} — ${n.enlace}${n.resumen ? ' — ' + n.resumen : ''}`).join('\\n');\nreturn [{ json: { texto } }];"
      }
    },
    {
      "id": "41557e0c-b64d-5fd9-8839-cee39d99d8a7",
      "name": "Elegir tendencias",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        1220,
        200
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.texto }}",
        "hasOutputParser": false,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "Eres un editor que sigue de cerca inteligencia artificial, automatización, marketing digital, desarrollo web y apps. De la lista numerada de esta semana, elige las 5 tendencias más relevantes y útiles (prefiere lanzamientos, herramientas nuevas y proyectos que se puedan usar; descarta rumores, finanzas y polémicas). Escribe en español, en texto plano para Telegram (sin Markdown ni emojis), con este formato para cada una:\n1. Título claro\nPor qué importa, en 2 frases, sin inventar nada que no esté en la lista.\nEnlace\n\nTermina con una línea: «La que más me interesa esta semana: …» y por qué, en una frase."
            }
          ]
        }
      }
    },
